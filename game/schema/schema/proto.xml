<schema>
    <class name="NetVec2" proto="true">
        <element name="x" type="float" proto_id="1"/>
        <element name="y" type="float" proto_id="2"/>
    </class>

    <class name="Echo" proto_id="1">
        <element name="msg" type="std::string" proto_id="1"/>
    </class>

    <class name="TalkMsg" proto_id="2">
        <element name="msg" type="std::string" proto_id="1"/>
    </class>

    <class name="Connect" proto_id="3">
    </class>

    <class name="Disconnect" proto_id="4">
    </class>

    <!--spawn a entity-->
    <class name="SpawnPlayer" proto_id="10">
        <element name="entity" type="uint32_t" proto_id="1"/>
        <element name="did" type="uint32_t" proto_id="2"/>
    </class>

    <class name="Kill" proto_id="6">
        <element name="entity" type="uint32_t" proto_id="1"/>
    </class>

    <class name="Move" proto_id="7">
        <element name="entity" type="uint32_t" proto_id="1"/>
        <element name="seq" type="uint32_t" proto_id="2"/>
        <element name="target" type="NetVec2" proto_id="3"/>
    </class>

    <enum name="ClientActionType" proto="true">
        <item name="ClientActionType_Move" value="0"/>
        <item name="ClientActionType_Attack" value="1"/>
    </enum>

    <class name="ClientAction" proto_id="9">
        <element name="action" type="ClientActionType" proto_id="1"/>
        <option name="move_disp" type="NetVec2" proto_id="2"/>
        <element name="timestamp" type="double" proto_id ="3" />
        <element name="seq" type="uint32_t" proto_id="4" />
    </class>
</schema>